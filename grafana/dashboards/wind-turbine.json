    {
      "type": "stat",
      "title": "Performance index",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "pluginVersion": "13.2.4",
      "description": "Actual / expected energy over fully available producing intervals expecting more than 500 kW; expected power comes from the turbine's reference curve at the measured wind speed.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-fleet"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-fleet"
          },
          "query": "from(bucket: \"fleet\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"wind_turbine\" and (r._field == \"power_kw\" or r._field == \"expected_kw\" or r._field == \"state\" or r._field == \"available\") and r.asset == \"${turbine}\")\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> filter(fn: (r) => exists r.power_kw and exists r.expected_kw and exists r.state and exists r.available)\n  |> filter(fn: (r) => r.state == 0 and r.available >= 1.0 and r.expected_kw > 500.0)\n  |> reduce(identity: {actual: 0.0, expected: 0.0, n: 0}, fn: (r, accumulator) => ({actual: accumulator.actual + r.power_kw, expected: accumulator.expected + r.expected_kw, n: accumulator.n + 1}))\n  |> filter(fn: (r) => r.n >= 12 and r.expected > 0.0)\n  |> map(fn: (r) => ({r with _value: r.actual / r.expected}))\n  |> map(fn: (r) => ({r with _time: r._stop}))\n  |> keep(columns: [\"_time\", \"_value\", \"site\", \"asset\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 0.85,
                "color": "orange"
              },
              {
                "value": 0.95,
                "color": "green"
              }
            ]
          },
          "mappings": [],
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "id": 5
    },
