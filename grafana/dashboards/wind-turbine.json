          "query": "from(bucket: \"fleet\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"wind_turbine\" and (r._field == \"wind_speed\" or r._field == \"power_kw\") and r.asset == \"${turbine}\")\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> keep(columns: [\"wind_speed\", \"power_kw\"])"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-fleet"
          },
          "query": "from(bucket: \"reference\")\n  |> range(start: 0, stop: 1000000)\n  |> filter(fn: (r) => r._measurement == \"power_curve\" and r.asset == \"${turbine}\")\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> keep(columns: [\"wind_speed\", \"power_kw\"])"
        }
