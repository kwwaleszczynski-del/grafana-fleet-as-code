{
  "uid": "fleet-overview",
  "title": "Fleet overview",
  "description": "Wind and PV fleet KPIs from the live replay. Replay at 60x: one minute on the time axis is 60 minutes of plant time, so the default 'last 1 hour' shows 2.5 days of operation.",
  "tags": [
    "fleet"
  ],
  "editable": false,
  "graphTooltip": 1,
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
      "title": "Fleet",
      "type": "dashboards",
      "tags": [
        "fleet"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link"
    }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Plant clock",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "pluginVersion": "13.2.4",
      "description": "Historical time being replayed at each site. Replay at 60x: one minute on the time axis is 60 minutes of plant time, so the default 'last 1 hour' shows 2.5 days of operation.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-fleet"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-fleet"
          },
          "query": "from(bucket: \"fleet\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"replay\" and r._field == \"plant_clock\")\n  |> last()\n  |> keep(columns: [\"_value\", \"_field\", \"site\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "string",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "text"
              }
            ]
          },
          "mappings": [],
          "displayName": "${__field.labels.site}"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {
          "valueSize": 16
        }
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Fleet power",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "pluginVersion": "13.2.4",
      "description": "Latest power of all turbines and the PV inverter.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-fleet"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-fleet"
          },
          "query": "from(bucket: \"fleet\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => (r._measurement == \"wind_turbine\" and r._field == \"power_kw\") or (r._measurement == \"pv_inverter\" and r._field == \"ac_kw\"))\n  |> last()\n  |> group()\n  |> sum()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatt",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "text"
              }
            ]
          },
          "mappings": [],
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Energy in range",
      "gridPos": {
        "x": 9,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "pluginVersion": "13.2.4",
      "description": "Exported energy in the selected time range (sum of 10/15-minute energy values).",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-fleet"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-fleet"
          },
          "query": "wind = from(bucket: \"fleet\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"wind_turbine\" and r._field == \"energy_kwh\")\n  |> group()\n  |> sum()\n  |> set(key: \"source\", value: \"Wind\")\n  |> group(columns: [\"source\"])\npv = from(bucket: \"fleet\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"pv_inverter\" and r._field == \"energy_kwh\")\n  |> group()\n  |> sum()\n  |> set(key: \"source\", value: \"PV\")\n  |> group(columns: [\"source\"])\nunion(tables: [wind, pv])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "text"
              }
            ]
          },
          "mappings": [],
          "decimals": 1,
          "displayName": "${__field.labels.source}"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Wind availability",
      "gridPos": {
        "x": 14,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "pluginVersion": "13.2.4",
      "description": "Time-based availability (IEC 61400-26-1 categories) across all turbines.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-fleet"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-fleet"
          },
          "query": "from(bucket: \"fleet\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"wind_turbine\" and r._field == \"available\")\n  |> group()\n  |> mean()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 0.9,
                "color": "orange"
              },
              {
                "value": 0.97,
                "color": "green"
              }
            ]
          },
          "mappings": [],
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "Wind capacity factor",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "pluginVersion": "13.2.4",
      "description": "Mean power / rated power over the range.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-fleet"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-fleet"
          },
          "query": "from(bucket: \"fleet\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"wind_turbine\" and r._field == \"power_kw\")\n  |> group()\n  |> mean()\n  |> map(fn: (r) => ({r with _value: r._value / 2050.0}))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "text"
              }
            ]
          },
          "mappings": [],
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "id": 5
    },
    {
      "type": "stat",
      "title": "PV performance ratio",
      "gridPos": {
        "x": 21,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "pluginVersion": "13.2.4",
      "description": "IEC 61724-1 PR over records with POA above 50 W/m2. This roof normally runs at PR 0.55-0.6.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-fleet"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-fleet"
          },
          "query": "from(bucket: \"fleet\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"pv_inverter\" and (r._field == \"ac_kw\" or r._field == \"poa_wm2\"))\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> filter(fn: (r) => exists r.ac_kw and exists r.poa_wm2 and r.poa_wm2 > 50.0)\n  |> reduce(identity: {e: 0.0, h: 0.0, n: 0}, fn: (r, accumulator) => ({e: accumulator.e + r.ac_kw, h: accumulator.h + r.poa_wm2 / 1000.0 * 146.64, n: accumulator.n + 1}))\n  |> filter(fn: (r) => r.n >= 4 and r.h > 0.0)\n  |> map(fn: (r) => ({r with _value: r.e / r.h}))\n  |> map(fn: (r) => ({r with _time: r._stop}))\n  |> keep(columns: [\"_time\", \"_value\", \"site\", \"asset\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 0.35,
                "color": "orange"
              },
              {
                "value": 0.5,
                "color": "green"
              }
            ]
          },
          "mappings": [],
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Power by asset",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 16,
        "h": 9
      },
      "pluginVersion": "13.2.4",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-fleet"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-fleet"
          },
          "query": "from(bucket: \"fleet\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => (r._measurement == \"wind_turbine\" and r._field == \"power_kw\") or (r._measurement == \"pv_inverter\" and r._field == \"ac_kw\"))\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ],
      "fieldConfig": {
        "defaults": {
