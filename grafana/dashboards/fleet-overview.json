          },
          "query": "from(bucket: \"fleet\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => (r._measurement == \"wind_turbine\" or r._measurement == \"pv_inverter\") and r._field == \"available\")\n  |> mean()\n  |> map(fn: (r) => ({r with _time: r._stop}))\n  |> keep(columns: [\"_time\", \"_value\", \"site\", \"asset\"])"
        }
