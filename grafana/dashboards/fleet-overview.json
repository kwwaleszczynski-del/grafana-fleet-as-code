          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "20s",
      "id": 7
    },
    {
      "type": "alertlist",
      "title": "Active alerts",
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 9
      },
      "pluginVersion": "13.2.4",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "viewMode": "list",
        "groupMode": "default",
        "groupBy": [],
        "maxItems": 20,
        "sortOrder": 1,
        "dashboardAlerts": false,
        "alertName": "",
        "alertInstanceLabelFilter": "{fleet=\"demo\"}",
        "showInstances": false,
        "stateFilter": {
          "firing": true,
          "pending": true,
          "noData": true,
          "normal": false,
          "error": true,
          "recovering": true
        }
      },
      "id": 8
    },
    {
      "type": "table",
      "title": "Assets",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 14,
        "h": 9
      },
      "pluginVersion": "13.2.4",
      "description": "Energy, availability and last state per asset. Performance is actual / expected energy for turbines and the performance ratio for PV. Click a turbine for its detail dashboard.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-fleet"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-fleet"
          },
          "query": "data = from(bucket: \"fleet\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"wind_turbine\" or r._measurement == \"pv_inverter\")\nenergy = data |> filter(fn: (r) => r._field == \"energy_kwh\") |> sum()\navail = data |> filter(fn: (r) => r._field == \"available\") |> mean()\nstate = data |> filter(fn: (r) => r._field == \"state\") |> last() |> toFloat()\nunion(tables: [energy, avail, state])\n  |> group()\n  |> pivot(rowKey: [\"asset\", \"_measurement\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> keep(columns: [\"asset\", \"_measurement\", \"energy_kwh\", \"available\", \"state\"])"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-fleet"
          },
          "query": "wind = from(bucket: \"fleet\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"wind_turbine\" and (r._field == \"power_kw\" or r._field == \"expected_kw\" or r._field == \"state\" or r._field == \"available\"))\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> filter(fn: (r) => exists r.power_kw and exists r.expected_kw and exists r.state and exists r.available)\n  |> filter(fn: (r) => r.state == 0 and r.available >= 1.0 and r.expected_kw > 500.0)\n  |> reduce(identity: {actual: 0.0, expected: 0.0, n: 0}, fn: (r, accumulator) => ({actual: accumulator.actual + r.power_kw, expected: accumulator.expected + r.expected_kw, n: accumulator.n + 1}))\n  |> filter(fn: (r) => r.n >= 12 and r.expected > 0.0)\n  |> map(fn: (r) => ({r with _value: r.actual / r.expected}))\n  |> map(fn: (r) => ({r with _time: r._stop}))\n  |> keep(columns: [\"_time\", \"_value\", \"site\", \"asset\"])\npv = from(bucket: \"fleet\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"pv_inverter\" and (r._field == \"ac_kw\" or r._field == \"poa_wm2\"))\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> filter(fn: (r) => exists r.ac_kw and exists r.poa_wm2 and r.poa_wm2 > 50.0)\n  |> reduce(identity: {e: 0.0, h: 0.0, n: 0}, fn: (r, accumulator) => ({e: accumulator.e + r.ac_kw, h: accumulator.h + r.poa_wm2 / 1000.0 * 146.64, n: accumulator.n + 1}))\n  |> filter(fn: (r) => r.n >= 4 and r.h > 0.0)\n  |> map(fn: (r) => ({r with _value: r.e / r.h}))\n  |> map(fn: (r) => ({r with _time: r._stop}))\n  |> keep(columns: [\"_time\", \"_value\", \"site\", \"asset\"])\nunion(tables: [wind, pv])\n  |> group()\n  |> keep(columns: [\"asset\", \"_value\"])\n  |> rename(columns: {_value: \"performance\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": false
          },
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "text"
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Asset"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Type"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 120
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 170
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Energy"
            },
            "properties": [
              {
                "id": "unit",
                "value": "kwatth"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Availability"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "value": null,
                      "color": "red"
                    },
                    {
                      "value": 0.9,
                      "color": "orange"
                    },
                    {
                      "value": 0.97,
                      "color": "green"
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Performance"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Producing",
                        "color": "green",
                        "index": 0
                      },
                      "1": {
                        "text": "Ready, not producing",
                        "color": "blue",
                        "index": 1
                      },
                      "2": {
                        "text": "Stopped, out of spec",
                        "color": "yellow",
                        "index": 2
                      },
                      "3": {
                        "text": "Maintenance",
                        "color": "purple",
                        "index": 3
                      },
                      "4": {
                        "text": "Fault",
                        "color": "red",
                        "index": 4
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Type"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "wind_turbine": {
                        "text": "Wind turbine",
                        "index": 0
                      },
                      "pv_inverter": {
                        "text": "PV inverter",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
