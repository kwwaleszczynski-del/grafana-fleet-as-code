        "w": 12,
        "h": 8
      },
      "pluginVersion": "13.2.4",
      "description": "Hourly PR (window means, POA > 200 W/m2). The red band is the alert threshold.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-fleet"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-fleet"
          },
          "query": "from(bucket: \"fleet\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"pv_inverter\" and (r._field == \"ac_kw\" or r._field == \"poa_wm2\"))\n  |> aggregateWindow(every: 60s, fn: mean, createEmpty: false)\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> filter(fn: (r) => exists r.ac_kw and exists r.poa_wm2 and r.poa_wm2 > 200.0)\n  |> map(fn: (r) => ({_time: r._time, _field: \"PR\", _value: r.ac_kw / (r.poa_wm2 / 1000.0 * 146.64)}))"
        }
