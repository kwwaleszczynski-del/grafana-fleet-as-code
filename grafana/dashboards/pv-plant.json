            "uid": "influxdb-fleet"
          },
          "query": "from(bucket: \"fleet\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"pv_inverter\" and r._field == \"poa_wm2\")\n  |> sum()\n  |> map(fn: (r) => ({r with _value: r._value * 0.25 / 1000.0}))"
