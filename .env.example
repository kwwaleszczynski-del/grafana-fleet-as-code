# Copy to .env and replace every value marked change-me. .env is git-ignored.
# Generate random values e.g. with: python -c "import secrets; print(secrets.token_urlsafe(32))"

# InfluxDB 2 admin (used for the initial setup only) and the API token shared by Grafana and the replay
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=change-me
INFLUX_TOKEN=change-me
INFLUX_ORG=fleet-demo
# where the host-side tools (replay, setup) reach InfluxDB; the Grafana container uses http://influxdb:8086
INFLUX_URL=http://127.0.0.1:8086

# Grafana admin (dashboards are also readable anonymously as Viewer, ports are bound to 127.0.0.1)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me
GRAFANA_URL=http://127.0.0.1:3000

# shared secret between Grafana and the optional image renderer (docker compose --profile render)
RENDERER_TOKEN=change-me
